<section class="cta-section" aria-labelledby="cta-title">
  <div class="cta-inner glass">
    <div class="cta-content blur-reveal">
      <p class="eyebrow">Ready to Start?</p>
      <h2 id="cta-title" class="cta-title">
        Get Your Free Glass Estimate Today
      </h2>
      <p class="cta-subtitle">
        Serving Dallas, Carrollton, Plano, Irving, Frisco and all of DFW.
        Most projects quoted within 24 hours.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary">Request Free Quote</a>
        <a href="tel:+19725850388" class="btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.9a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.6a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/></svg>
          Call (972) 585-0388
        </a>
      </div>
      <p class="cta-note">Free estimates · No pressure · Licensed & Insured</p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .cta-inner {
    border-radius: var(--radius-lg);
    padding: 4rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Radial glow from top */
  .cta-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(42, 109, 181, 0.18) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Diagonal line texture */
  .cta-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -55deg,
      transparent,
      transparent 18px,
      rgba(42, 109, 181, 0.035) 18px,
      rgba(42, 109, 181, 0.035) 19px
    );
    pointer-events: none;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .cta-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto 2.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2rem;
    background: var(--color-accent);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(42, 109, 181, 0.35);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(42, 109, 181, 0.5);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    background: transparent;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .cta-note {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
