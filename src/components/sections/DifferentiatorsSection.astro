---
const differentiators = [
  {
    n: '01',
    title: 'Precision Templating',
    desc: 'Every installation starts with an on-site template. We measure twice, cut once — guaranteed perfect fit.',
  },
  {
    n: '02',
    title: 'Premium Materials Only',
    desc: 'We use exclusively 3/8" and 1/2" tempered safety glass from certified suppliers. No shortcuts.',
  },
  {
    n: '03',
    title: 'Fast Turnaround',
    desc: 'Most residential projects completed within 5–7 business days of the template appointment.',
  },
  {
    n: '04',
    title: 'Licensed & Insured',
    desc: 'Fully licensed in Texas. Comprehensive liability insurance protects you and your property on every job.',
  },
  {
    n: '05',
    title: 'Clear Communication',
    desc: "You'll always know where your project stands. Direct line to your project lead from day one.",
  },
  {
    n: '06',
    title: 'Clean Installation',
    desc: 'We leave every job site cleaner than we found it. Precision cutting happens off-site to minimize mess.',
  },
];
---

<section class="section diff-section" aria-labelledby="diff-title">
  <div class="container">
    <div class="diff-layout">

      <div class="diff-intro">
        <div class="intro-rule"></div>
        <p class="eyebrow">Why Choose Us</p>
        <h2 id="diff-title" class="section-title">
          The Freedom Glass<br />Difference
        </h2>
        <p class="diff-lead">
          There's no shortage of glass companies in Dallas. Here's what sets us apart —
          and why our clients keep coming back and referring their friends.
        </p>
        <a href="/contact" class="btn-primary">Get Your Free Quote</a>
      </div>

      <div class="diff-list">
        {differentiators.map(({ n, title, desc }, i) => (
          <article class="diff-item" style={`--i:${i}`}>
            <span class="diff-n" aria-hidden="true">{n}</span>
            <div class="diff-body">
              <h3 class="diff-title">{title}</h3>
              <p class="diff-desc">{desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.diff-item');
  const io = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    }),
    { threshold: 0.12 }
  );
  items.forEach(el => io.observe(el));
</script>

<style>
  .diff-section { padding-block: 6rem; }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 2rem;
  }

  .diff-layout {
    display: grid;
    grid-template-columns: 1fr 1.65fr;
    gap: 5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .diff-layout { grid-template-columns: 1fr; gap: 3rem; }
  }

  .diff-intro {
    /* sticky only on wide screens where the two-column layout is active */
  }

  @media (min-width: 901px) {
    .diff-intro {
      position: sticky;
      top: 8rem;
    }
  }

  .intro-rule {
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .diff-lead {
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 4px 20px rgba(31, 96, 168, 0.28);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  /* ── List ── */
  .diff-list {
    display: flex;
    flex-direction: column;
  }

  .diff-item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1.25rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s ease calc(var(--i) * 0.07s),
      transform 0.5s ease calc(var(--i) * 0.07s);
  }

  .diff-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .diff-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .diff-n {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    opacity: 0.45;
    padding-top: 0.2rem;
    line-height: 1;
  }

  .diff-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .diff-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin: 0;
  }

  .diff-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 48ch;
    margin: 0;
  }

  @media (max-width: 768px) {
    .diff-section { padding-block: 4rem; }
    .container { padding-inline: 1.5rem; }
    .diff-layout { gap: 2rem; }
    .diff-item { padding-block: 1.25rem; gap: 1rem; }
  }

  @media (max-width: 480px) {
    .diff-section { padding-block: 2.5rem; }
    .container { padding-inline: 1rem; }
    .diff-item { padding-block: 1rem; gap: 0.75rem; }
    .section-title { font-size: 1.6rem; }
    .btn-primary { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .diff-item { opacity: 1; transform: none; transition: none; }
  }
</style>
