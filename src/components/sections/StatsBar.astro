---
const stats = [
  { value: '4.9★', label: 'Google Rating',       sub: '40 reviews',      count: 4.9, suffix: '★', decimals: 1 },
  { value: '500+', label: 'Projects Completed',   sub: 'DFW & beyond',    count: 500, suffix: '+', decimals: 0 },
  { value: '10+',  label: 'Years Experience',     sub: 'Expert craftsmen', count: 10, suffix: '+', decimals: 0 },
  { value: '100%', label: 'Licensed & Insured',   sub: 'Full coverage',   count: 100, suffix: '%', decimals: 0 },
];
---

<div class="stats-bar glass">
  <div class="stats-inner">
    {stats.map(({ value, label, sub, count, suffix, decimals }) => (
      <div class="stat-item">
        <span
          class="stat-value gradient-text"
          data-count={count}
          data-suffix={suffix}
          data-decimals={decimals}
          aria-label={value}
        >{value}</span>
        <div class="stat-text">
          <span class="stat-label">{label}</span>
          <span class="stat-sub">{sub}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');

  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseFloat(el.dataset.count ?? '0');
      const suffix = el.dataset.suffix ?? '';
      const decimals = parseInt(el.dataset.decimals ?? '0', 10);
      const duration = 1700;
      const start = performance.now();

      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = (eased * target).toFixed(decimals) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      io.unobserve(el);
    });
  }, { threshold: 0.6 });

  counters.forEach(el => io.observe(el));
</script>

<style>
  .stats-bar {
    margin: 0 2rem;
    border-radius: var(--radius-lg);
    transform: translateY(-3rem);
    position: relative;
    z-index: 10;
  }

  .stats-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .stats-bar { margin: 0 1rem; transform: translateY(-2rem); }
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .stats-inner { grid-template-columns: 1fr; }
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-right: 1px solid var(--border);
  }

  .stat-item:last-child { border-right: none; }

  @media (max-width: 768px) {
    .stat-item { border-right: none; border-bottom: 1px solid var(--border); }
    .stat-item:nth-last-child(-n+2) { border-bottom: none; }
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .stat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
