---
const stats = [
  { value: '4.9★', label: 'Google Rating', sub: '40 reviews' },
  { value: '500+', label: 'Projects Completed', sub: 'DFW & beyond' },
  { value: '10+', label: 'Years Experience', sub: 'Expert craftsmen' },
  { value: '100%', label: 'Licensed & Insured', sub: 'Full coverage' },
];
---

<div class="stats-bar glass">
  <div class="stats-inner">
    {stats.map(({ value, label, sub }) => (
      <div class="stat-item">
        <span class="stat-value gradient-text">{value}</span>
        <div class="stat-text">
          <span class="stat-label">{label}</span>
          <span class="stat-sub">{sub}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .stats-bar {
    margin: 0 2rem;
    border-radius: var(--radius-lg);
    transform: translateY(-3rem);
    position: relative;
    z-index: 10;
  }

  .stats-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .stats-bar { margin: 0 1rem; transform: translateY(-2rem); }
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .stats-inner { grid-template-columns: 1fr; }
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-right: 1px solid var(--border);
  }

  .stat-item:last-child { border-right: none; }

  @media (max-width: 768px) {
    .stat-item { border-right: none; border-bottom: 1px solid var(--border); }
    .stat-item:nth-child(2n) { border-right: none; }
    .stat-item:nth-last-child(-n+2) { border-bottom: none; }
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .stat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
