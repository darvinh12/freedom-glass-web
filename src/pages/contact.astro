---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Freedom Glass Remodeling Dallas TX"
  description="Get a free glass estimate. Call (972) 585-0388 or fill out our contact form. Serving Dallas, Carrollton, Plano, Irving, Frisco and all DFW."
  canonical="/contact"
>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 8rem 2rem;">
    <div style="text-align: center;">
      <h1 style="font-family: var(--font-display); font-size: 3rem; color: var(--text); margin-bottom: 1rem;">Contact Us</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem;">Coming soon — this page is under construction.</p>
      <a href="tel:+19725850388" style="display: inline-flex; margin-top: 2rem; padding: 0.875rem 1.75rem; background: var(--color-accent); color: #0a0a0f; border-radius: 8px; text-decoration: none; font-weight: 600; margin-right: 1rem;">📞 (972) 585-0388</a>
      <a href="/" style="display: inline-flex; margin-top: 2rem; padding: 0.875rem 1.75rem; border: 1.5px solid var(--border); color: var(--text); border-radius: 8px; text-decoration: none; font-weight: 600;">← Back to Home</a>
    </div>
  </div>
</BaseLayout>
