---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqGroups = [
  {
    category: 'General',
    questions: [
      {
        q: 'Do you offer free estimates?',
        a: 'Yes — all estimates are 100% free and come with no obligation. We typically provide quotes within 24 hours of your inquiry, and most in-person measurements can be scheduled same week.',
      },
      {
        q: 'What areas do you serve?',
        a: 'We serve all of Dallas–Fort Worth, including Dallas, Carrollton, Plano, Irving, Frisco, Garland, Richardson, Addison, Farmers Branch, Allen, McKinney, and Lewisville — and surrounding areas. Not sure if we cover your location? Just call us.',
      },
      {
        q: 'Are you licensed and insured?',
        a: 'Yes. Freedom Glass Remodeling LLC is fully licensed in the state of Texas and carries comprehensive general liability insurance. We protect our clients, their property, and our crews on every job.',
      },
      {
        q: 'How long has Freedom Glass been in business?',
        a: 'We were founded in 2018 and have been proudly serving Dallas–Fort Worth ever since. In that time we have completed over 500 projects across residential, commercial, and specialty glass categories.',
      },
    ],
  },
  {
    category: 'Frameless Shower Doors',
    questions: [
      {
        q: 'What glass thickness do you use for shower enclosures?',
        a: 'We use 3/8" (10mm) and 1/2" (12mm) tempered safety glass — the industry standard for frameless shower enclosures. Both options are extremely durable and safe. We will recommend the right thickness based on your design and door size.',
      },
      {
        q: 'How long does the installation process take?',
        a: 'The full process typically takes 1–2 weeks from initial measurement to installation. We visit your bathroom to take precise template measurements, custom-cut your glass, then return for installation — which usually takes just a few hours.',
      },
      {
        q: 'What hardware finishes are available?',
        a: 'We offer brushed nickel, matte black, polished chrome, and oil-rubbed bronze. We can also source custom hardware finishes for premium projects. Our team will show you samples and help you match your bathroom fixtures.',
      },
      {
        q: "What's the difference between frameless and semi-frameless?",
        a: 'Frameless enclosures use thick tempered glass with minimal metal hardware — giving a clean, open look. Semi-frameless uses a thin frame along the top and sides for extra support. Frameless is more modern and easier to clean; semi-frameless can be more cost-effective for larger openings.',
      },
      {
        q: 'Do you handle 90° corner showers and custom angles?',
        a: 'Absolutely. We specialize in 90° corner enclosures, 80° angled configurations, neo-angle designs, and fully custom shapes. We take exact measurements on-site to ensure a perfect fit regardless of your bathroom geometry.',
      },
    ],
  },
  {
    category: 'Commercial Glass',
    questions: [
      {
        q: 'Do you handle large-scale commercial projects?',
        a: 'Yes. We work with offices, restaurants, hotels, gyms, and retail spaces of all sizes — from a single conference room partition to full floor-to-ceiling glass walls across an entire office build-out.',
      },
      {
        q: 'Can you install frosted or privacy glass for offices?',
        a: 'Yes. We offer frosted glass, acid-etched glass, privacy film application, and decorative patterns. These are popular for conference rooms, executive offices, and healthcare settings where privacy is important without sacrificing light.',
      },
      {
        q: 'Do you work with general contractors and architects?',
        a: 'Absolutely. We are experienced in commercial coordination and happy to work as a subcontractor alongside your GC. We can provide drawings, shop documents, and coordinate scheduling to fit your project timeline.',
      },
    ],
  },
  {
    category: 'Pricing & Process',
    questions: [
      {
        q: 'What affects the cost of a frameless shower enclosure?',
        a: 'Key factors include the size of the enclosure, glass thickness (3/8" vs 1/2"), hardware finish, number of panels and doors, and any special features like rain glass or low-iron ultra-clear glass. We provide itemized quotes so you know exactly what you are paying for.',
      },
      {
        q: 'How does the estimate process work?',
        a: "It starts with a free consultation — call, text, or fill out our contact form. We'll schedule a visit to measure your space, discuss your options, and provide a detailed written quote. No surprises, no hidden fees.",
      },
      {
        q: 'What payment methods do you accept?',
        a: 'We accept cash, check, and major credit cards. For larger commercial projects, we can discuss payment schedules. Contact us for details.',
      },
      {
        q: 'How soon can you start a project?',
        a: 'For residential projects, we can typically begin templating within a week of quote approval. Commercial timelines vary by project scope. We will give you a realistic start and completion date when we provide your quote.',
      },
    ],
  },
];
---

<BaseLayout
  title="FAQ | Freedom Glass Remodeling LLC"
  description="Frequently asked questions about frameless shower doors, commercial glass, custom mirrors, pricing, and our installation process in Dallas–Fort Worth."
  canonical="/faq"
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <p class="eyebrow">Questions & Answers</p>
      <h1 class="page-title">Frequently Asked<br/>Questions</h1>
      <p class="page-subtitle">
        Can't find what you're looking for? Call us at
        <a href="tel:+19725850388" class="hero-link">(972) 585-0388</a>
        — we're happy to help.
      </p>
    </div>
  </section>

  <!-- FAQ CONTENT -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-layout">

        <!-- CATEGORY NAV (desktop) -->
        <nav class="faq-nav" aria-label="FAQ categories">
          {faqGroups.map(g => (
            <a href={`#faq-${g.category.toLowerCase().replace(/\s+&?\s*/g, '-')}`} class="faq-nav-link">
              {g.category}
            </a>
          ))}
        </nav>

        <!-- ACCORDION GROUPS -->
        <div class="faq-groups">
          {faqGroups.map(group => (
            <div
              id={`faq-${group.category.toLowerCase().replace(/\s+&?\s*/g, '-')}`}
              class="faq-group"
            >
              <h2 class="faq-group-title blur-reveal">{group.category}</h2>
              <div class="faq-items">
                {group.questions.map(item => (
                  <details class="faq-item">
                    <summary class="faq-question">
                      <span>{item.q}</span>
                      <span class="faq-chevron" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                      </span>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="faq-cta-section">
    <div class="container">
      <div class="faq-cta glass blur-reveal">
        <div class="faq-cta-glow" aria-hidden="true"></div>
        <p class="eyebrow">Still Have Questions?</p>
        <h2 class="cta-title">Let's Talk</h2>
        <p class="cta-sub">
          Our team is available Monday–Saturday. Most questions answered in minutes.
        </p>
        <div class="cta-actions">
          <a href="/contact" class="btn-primary">Send Us a Message</a>
          <a href="tel:+19725850388" class="btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.9a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.6a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/></svg>
            (972) 585-0388
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== PAGE HERO ===== */
  .page-hero {
    position: relative;
    padding: 9rem 2rem 6rem;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(31,96,168,.16) 0%, transparent 65%),
      repeating-linear-gradient(-55deg, transparent, transparent 18px, rgba(31,96,168,.025) 18px, rgba(31,96,168,.025) 19px);
    pointer-events: none;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .hero-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }
  .hero-link:hover { text-decoration: underline; }

  /* ===== FAQ SECTION ===== */
  .faq-section { padding-block: 5rem 7rem; }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 2rem;
  }
  .faq-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) { .faq-layout { grid-template-columns: 1fr; gap: 2.5rem; } }

  /* ===== FAQ NAV ===== */
  .faq-nav {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  @media (max-width: 900px) {
    .faq-nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
  .faq-nav-link {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .faq-nav-link:hover {
    background: var(--bg-card);
    color: var(--text);
  }
  @media (max-width: 900px) {
    .faq-nav-link {
      border: 1px solid var(--border);
      font-size: 0.8rem;
      padding: 0.375rem 0.75rem;
    }
  }

  /* ===== FAQ GROUPS ===== */
  .faq-groups {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .faq-group { }
  .faq-group-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--border);
  }
  .faq-items {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ===== ACCORDION ===== */
  .faq-item {
    border-bottom: 1px solid var(--border);
  }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
    user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { color: var(--color-accent); }
  .faq-item[open] .faq-question { color: var(--color-accent); }

  .faq-chevron {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); color: var(--color-accent); }

  .faq-answer {
    padding-bottom: 1.25rem;
    padding-right: 2rem;
  }
  .faq-answer p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  /* ===== FAQ CTA ===== */
  .faq-cta-section { padding-block: 3rem 7rem; }
  .faq-cta {
    border-radius: var(--radius-lg);
    padding: 5rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .faq-cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(31,96,168,.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    position: relative;
  }
  .cta-sub {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    position: relative;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 4px 20px rgba(31,96,168,.35);
  }
  .btn-primary:hover { background: var(--color-accent-hover); transform: translateY(-2px); }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: transparent;
    color: var(--text);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    border: 1.5px solid var(--border);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }
</style>
