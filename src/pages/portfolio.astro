---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Portfolio | Freedom Glass Remodeling Dallas TX"
  description="Browse 170+ completed glass projects: frameless showers, custom mirrors, commercial partitions, and more across Dallas / Fort Worth."
  canonical="/portfolio"
>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 8rem 2rem;">
    <div style="text-align: center;">
      <h1 style="font-family: var(--font-display); font-size: 3rem; color: var(--text); margin-bottom: 1rem;">Portfolio</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem;">Coming soon — this page is under construction.</p>
      <a href="/" style="display: inline-flex; margin-top: 2rem; padding: 0.875rem 1.75rem; background: var(--color-accent); color: #0a0a0f; border-radius: 8px; text-decoration: none; font-weight: 600;">← Back to Home</a>
    </div>
  </div>
</BaseLayout>
