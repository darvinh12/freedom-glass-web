---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PORTFOLIO } from '../../data/portfolio';
---

<BaseLayout
  title="Portfolio | Freedom Glass Remodeling LLC"
  description="Browse 500+ completed glass projects — frameless showers, custom mirrors, commercial partitions, wine rooms, and more across Dallas–Fort Worth."
  canonical="/portfolio"
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <p class="eyebrow">Our Work</p>
      <h1 class="page-title">500+ Projects.<br/>Zero Compromises.</h1>
      <p class="page-subtitle">
        Every project was measured twice, cut once, and installed with the precision our clients deserve.
        Browse by specialty below.
      </p>
    </div>
  </section>

  <!-- CATEGORY GRID -->
  <section class="cat-section">
    <div class="container">
      <div class="cat-grid">
        {PORTFOLIO.map(cat => (
          <a href={`/portfolio/${cat.id}`} class="cat-card" aria-label={`View ${cat.label} gallery`}>
            <div class="cat-thumb">
              <img
                src={cat.items[0].src}
                alt={cat.items[0].alt}
                class="cat-img"
                loading="lazy"
                width="480"
                height="360"
              />
              <div class="cat-overlay">
                <span class="cat-cta">View Gallery →</span>
              </div>
            </div>
            <div class="cat-info">
              <span class="cat-count">{cat.items.length} photos</span>
              <h2 class="cat-label">{cat.label}</h2>
              <p class="cat-desc">{cat.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="portfolio-cta-section">
    <div class="container">
      <div class="portfolio-cta glass blur-reveal">
        <div class="portfolio-cta-glow" aria-hidden="true"></div>
        <p class="eyebrow">Your Project Next</p>
        <h2 class="cta-title">Ready to Add Your Space<br/>to Our Portfolio?</h2>
        <p class="cta-sub">Free estimates · Most projects quoted within 24 hours · All DFW</p>
        <div class="cta-actions">
          <a href="/contact" class="btn-primary">Request Free Quote</a>
          <a href="/services" class="btn-ghost">View All Services</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== HERO ===== */
  .page-hero {
    position: relative;
    padding: 9rem 2rem 5rem;
    text-align: center;
    overflow: hidden;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(31,96,168,.16) 0%, transparent 65%),
      repeating-linear-gradient(-55deg, transparent, transparent 18px, rgba(31,96,168,.025) 18px, rgba(31,96,168,.025) 19px);
    pointer-events: none;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ===== CATEGORY GRID ===== */
  .cat-section { padding-block: 4rem 6rem; }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 2rem;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .cat-grid { grid-template-columns: 1fr; } }

  .cat-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    border-color: var(--color-accent);
  }

  .cat-thumb {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .cat-card:hover .cat-img { transform: scale(1.07); }

  .cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13,17,23,.85) 0%, rgba(13,17,23,.1) 60%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cat-card:hover .cat-overlay { opacity: 1; }
  .cat-cta {
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    background: var(--color-accent);
    padding: 0.4rem 0.9rem;
    border-radius: 6px;
  }

  .cat-info {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }
  .cat-count {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .cat-label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }
  .cat-desc {
    font-size: 0.83rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-top: 0.125rem;
  }

  /* ===== CTA ===== */
  .portfolio-cta-section { padding-block: 6rem; background: var(--bg-card); }
  .portfolio-cta {
    border-radius: var(--radius-lg);
    padding: 5rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .portfolio-cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(31,96,168,.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    position: relative;
    line-height: 1.15;
  }
  .cta-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
    position: relative;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 4px 20px rgba(31,96,168,.35);
  }
  .btn-primary:hover { background: var(--color-accent-hover); transform: translateY(-2px); }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: transparent;
    color: var(--text);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1.5px solid var(--border);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }

  @media (max-width: 768px) {
    .portfolio-cta { padding: 3rem 1.5rem; }
  }
</style>
