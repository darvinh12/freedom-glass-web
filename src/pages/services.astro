---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Glass Services | Freedom Glass Remodeling LLC"
  description="Frameless shower doors, custom mirrors, commercial glass partitions, window replacement and more. Serving Dallas–Fort Worth with precision and premium materials."
  canonical="/services"
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="page-hero-inner">
      <p class="eyebrow">What We Do</p>
      <h1 class="page-title">Glass Solutions<br/>for Every Space</h1>
      <p class="page-subtitle">
        From a single broken pane to a full commercial build-out — we bring precision
        craftsmanship and premium materials to every project across DFW.
      </p>
    </div>
  </section>

  <!-- SERVICE NAV -->
  <nav class="service-nav" aria-label="Jump to service">
    <div class="service-nav-inner">
      {services.map(s => (
        <a href={`#${s.id}`} class="snav-pill">{s.title}</a>
      ))}
    </div>
  </nav>

  <!-- SERVICE SECTIONS -->
  {services.map((service, i) => (
    <section id={service.id} class={`service-section ${i % 2 === 1 ? 'service-section--alt' : ''}`}>
      <div class={`service-inner container ${i % 2 === 1 ? 'service-inner--rev' : ''}`}>
        <div class="service-img-wrap">
          <img
            src={service.coverImage}
            alt={service.title}
            class="service-img"
            loading="lazy"
            width="600"
            height="440"
          />
          <div class="service-img-overlay" aria-hidden="true"></div>
        </div>
        <div class="service-content reveal-left">
          <p class="service-num">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="service-title">{service.title}</h2>
          <p class="service-desc">{service.description}</p>
          <ul class="features-list" role="list">
            {service.features.map(f => (
              <li class="feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
          <div class="service-ctas">
            <a href="/contact" class="btn-primary">Request Free Quote</a>
            <a href="tel:+19725850388" class="btn-ghost">Call Now</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- BOTTOM CTA -->
  <section class="services-cta-section">
    <div class="container">
      <div class="services-cta glass reveal-scale">
        <div class="services-cta-glow" aria-hidden="true"></div>
        <p class="eyebrow">All DFW Areas</p>
        <h2 class="cta-title">Not Sure Which Service You Need?</h2>
        <p class="cta-sub">
          Call us or send a message — we'll help you figure out the best solution
          for your space and budget. Free estimates always.
        </p>
        <div class="cta-actions">
          <a href="/contact" class="btn-primary">Get a Free Estimate</a>
          <a href="tel:+19725850388" class="btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.9a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.59 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.6a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/></svg>
            (972) 585-0388
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== PAGE HERO ===== */
  .page-hero {
    position: relative;
    padding: 9rem 2rem 6rem;
    text-align: center;
    overflow: hidden;
  }
  @media (max-width: 768px) { .page-hero { padding: 7rem 1.5rem 4rem; } }
  @media (max-width: 480px) { .page-hero { padding: 5.5rem 1rem 3rem; } }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(31,96,168,.16) 0%, transparent 65%),
      repeating-linear-gradient(-55deg, transparent, transparent 18px, rgba(31,96,168,.025) 18px, rgba(31,96,168,.025) 19px);
    pointer-events: none;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ===== SERVICE NAV ===== */
  .service-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
    position: sticky;
    top: 0;
    z-index: 40;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .service-nav::-webkit-scrollbar { display: none; }
  .service-nav-inner {
    display: flex;
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 2rem;
  }
  .snav-pill {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.25rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }
  .snav-pill:hover {
    color: var(--text);
    border-bottom-color: var(--color-accent);
  }

  /* ===== SERVICE SECTIONS ===== */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 2rem;
  }
  .service-section {
    padding-block: 6rem;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 768px) { .service-section { padding-block: 4rem; } }
  @media (max-width: 480px) { .service-section { padding-block: 2.5rem; } .container { padding-inline: 1rem; } }
  .service-section--alt { background: var(--bg-card); }

  .service-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .service-inner--rev .service-img-wrap { order: 2; }
  .service-inner--rev .service-content { order: 1; }

  @media (max-width: 900px) {
    .service-inner { grid-template-columns: 1fr; gap: 3rem; }
    .service-inner--rev .service-img-wrap { order: 0; }
    .service-inner--rev .service-content { order: 0; }
  }

  .service-img-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .service-img-wrap:hover .service-img { transform: scale(1.04); }
  .service-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,40,104,.25) 0%, transparent 60%);
  }

  .service-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }
  .service-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .service-desc {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 1rem;
    margin-bottom: 2rem;
  }
  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text);
  }
  .feature-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(31,96,168,.15);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .service-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.875rem;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 4px 20px rgba(31,96,168,.3);
  }
  .btn-primary:hover { background: var(--color-accent-hover); transform: translateY(-2px); }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    background: transparent;
    color: var(--text);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    border: 1.5px solid var(--border);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }

  /* ===== BOTTOM CTA ===== */
  .services-cta-section { padding-block: 6rem; }
  @media (max-width: 768px) { .services-cta-section { padding-block: 3rem; } }
  .services-cta {
    border-radius: var(--radius-lg);
    padding: 5rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .services-cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(31,96,168,.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    position: relative;
  }
  .cta-sub {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 2.5rem;
    position: relative;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: transparent;
    color: var(--text);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    border: 1.5px solid var(--border);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }

  @media (max-width: 768px) {
    .services-cta { padding: 3rem 1.5rem; }
    .service-ctas { flex-direction: column; }
    .btn-primary, .btn-ghost { width: 100%; justify-content: center; }
  }
  @media (max-width: 480px) {
    .services-cta { padding: 2rem 1rem; }
    .snav-pill { padding: 0.75rem 1rem; font-size: 0.75rem; }
  }
</style>
